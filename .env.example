NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Turns on the Jev interpreter for voice and text commands (console.typesafe.ai).
TYPESAFE_API_KEY=
# "fallback" (default): Jev is asked only when the built-in rules cannot produce an action. "always": Jev interprets every command.
NEXT_PUBLIC_JEV_MODE=fallback
